# Quarry KB local configuration placeholders.
# Copy to an untracked `.env` for local use. Never commit real secrets.

APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_USER=quarry
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=quarry_kb
DATABASE_URL=postgresql+psycopg://quarry:change-me-local-only@postgres:5432/quarry_kb

# Upload root stays outside Git (Compose volume / local path).
UPLOAD_ROOT=/data/uploads

# Intranet/gateway host allowlist for embedding and OCR only.
# Literal hostname or host:port match. No DNS resolution is performed.
# Default includes the documented bootstrap placeholder host.
GATEWAY_HOST_ALLOWLIST=gateway.internal

# Chat (provider-neutral placeholders; no live calls in repo-bootstrap)
CHAT_BASE_URL=http://gateway.internal/v1
CHAT_MODEL=placeholder-chat-model
CHAT_API_KEY=replace-me

# Embedding (internal gateway only; validated against allowlist)
EMBEDDING_BASE_URL=http://gateway.internal/v1
EMBEDDING_MODEL=placeholder-embedding-model
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=replace-me

# OCR / multimodal (internal gateway only; validated against allowlist)
OCR_BASE_URL=http://gateway.internal/v1
OCR_MODEL_PATH=/v1/ocr
OCR_TIMEOUT_SECONDS=120
OCR_API_KEY=replace-me

# Frontend
VITE_API_BASE_URL=/api/v1

# Auth (auth-password-jwt). Never commit real secrets.
JWT_SIGNING_KEY=replace-me-with-a-long-random-secret
AUTH_BOOTSTRAP_ON_STARTUP=true
# Required only on first boot when zero Admin accounts exist:
# AUTH_BOOTSTRAP_ADMIN_IDENTIFIER=admin
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-me-with-a-long-password
# AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
